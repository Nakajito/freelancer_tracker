DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB
SECURE_SSL_REDIRECT=True
# Ruta secreta del admin (ofuscación). Sin definir = "admin/". Usar un valor
# impredecible en producción, p.ej. ADMIN_URL=panel-7f3a9c/
ADMIN_URL=admin/
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
SEED_DEMO=0

# ──────────────────────────────────────────────────────────────────────────────
# Email (Brevo SMTP relay)
# Panel Brevo > SMTP & API > SMTP. DEFAULT_FROM_EMAIL debe ser un sender
# verificado en Brevo, o el envío será rechazado.
# ──────────────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=xxxxxxxx@smtp-brevo.com
EMAIL_HOST_PASSWORD=<smtp key del panel Brevo>
DEFAULT_FROM_EMAIL=noreply@tu-dominio.com

# ──────────────────────────────────────────────────────────────────────────────
# Mercado Pago
# Integración vía Preference API (pagos únicos) y Preapproval API (suscripciones).
#
# PRUEBAS: crea una cuenta de prueba en mercadopago.com/developers > Cuentas de prueba,
#          luego obtén sus credenciales de PRODUCCIÓN (Public Key + Access Token).
#          El Access Token de cuentas de prueba empieza con TEST-.
#          Nota: las "Credenciales de prueba" del panel solo aplican a Checkout API/Bricks,
#          NO a Preference ni Preapproval — siempre usar credenciales de producción de la cuenta de prueba.
#
# PRODUCCIÓN: reemplazá por el Access Token de producción (APP_USR-...).
# ──────────────────────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_PUBLIC_KEY=TEST-...
# Moneda ISO según el país de tu cuenta MP (MXN, ARS, BRL, CLP, COP, PEN, UYU)
MERCADOPAGO_CURRENCY=MXN

TURNSTILE_SITE_KEY=<site key del CF dashboard>
TURNSTILE_SECRET_KEY=<secret key del CF dashboard>
TURNSTILE_ENABLED=True
# Comma-separated CIDRs whose requests may set REMOTE_ADDR via CF-Connecting-IP.
# Defaults to Cloudflare's published edge ranges (https://www.cloudflare.com/ips/).
# Set to an empty value if the origin is NOT behind Cloudflare, so the header is
# never trusted. Getting this wrong lets clients forge their IP and slip the
# django-axes lockout and DRF anon throttle.
# CLOUDFLARE_IP_RANGES=

# Optional shared cache for DRF throttling and allauth rate limits. Without it
# production falls back to a database cache table; without either, throttle
# state is per gunicorn worker and the effective limit is multiplied by
# GUNICORN_WORKERS.
# REDIS_URL=redis://redis:6379/0

# "mandatory" (default) requires a confirmed address before login. Email is the
# only login identifier, so lowering this accepts unproven identities.
# ACCOUNT_EMAIL_VERIFICATION=mandatory

# Set True to let logins through when Cloudflare's siteverify is unreachable.
# Default False: an outage must not silently disable the CAPTCHA.
# TURNSTILE_FAIL_OPEN=False
